<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% block title %}Salary Predictor{% endblock %}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@700;800&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">
</head>
<body>

<nav>
  <div class="wrap">
    <a href="{{ url_for('dashboard') }}" class="brand"><span class="mark">$</span> SalaryIQ</a>
    <div class="navlinks">
      <a href="{{ url_for('dashboard') }}" class="{{ 'active' if active=='dashboard' else '' }}">Dashboard</a>
      <a href="{{ url_for('predict_form') }}" class="{{ 'active' if active=='predict' else '' }}">Predict Salary</a>
      <a href="{{ url_for('predict_form') }}" class="btn">New Prediction</a>
    </div>
  </div>
</nav>

{% block content %}{% endblock %}

<footer>
  <div class="wrap">
    <p>Employee salary prediction — trained on synthetic HR data.</p>
    <p class="mono">scikit-learn · Flask</p>
  </div>
</footer>

</body>
</html>
